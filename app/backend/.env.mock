# Mock Mode Configuration for Local Testing
# Copy this to .env to run locally without Databricks

# Enable mock mode
MOCK_MODE=true

# Application
APP_NAME=HEDIS Chat API (Mock)
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS - Allow frontend
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000"]
