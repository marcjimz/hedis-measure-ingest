# FastAPI Backend Configuration Example
# Copy this file to .env and update with your values

# Application Settings
APP_NAME="HEDIS Chat API"
APP_VERSION="1.0.0"
DEBUG=false

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Settings (comma-separated list)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Databricks Settings
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_token_here

# Unity Catalog Configuration
UC_CATALOG=marcin_demo2
UC_SCHEMA=hedis_measurements

# LLM Configuration
LLM_ENDPOINT=databricks-claude-sonnet-4-5

# Agent Configuration
AGENT_ENDPOINT=https://your-workspace.cloud.databricks.com/serving-endpoints/hedis-chat-agent
EFFECTIVE_YEAR=2025

# Vector Search Configuration
VECTOR_SEARCH_ENDPOINT=hedis_vector_endpoint
VECTOR_INDEX_NAME=hedis_measures_index

# Delta Tables for Chat History
CHATS_TABLE=hedis_chats
MESSAGES_TABLE=hedis_messages
REVIEWS_TABLE=hedis_reviews

# PostgreSQL/Lakebase Configuration (optional)
POSTGRES_ENABLED=false
POSTGRES_INSTANCE=hedis-agent-pg
POSTGRES_DATABASE=databricks_postgres

# SQL Warehouse Configuration (for Databricks Apps deployment)
# Required to access Delta tables via SQL Warehouse API (no PySpark)
# Find ID in: SQL > SQL Warehouses > Connection Details > Server hostname
SQL_WAREHOUSE_ID=your_warehouse_id_here

# Note: Authentication is handled by Databricks Apps built-in auth
# All requests are automatically authenticated via workspace SSO

# Rate Limiting (optional)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=3600
